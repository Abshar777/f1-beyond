# ── MongoDB ──────────────────────────────────────────────────────────────────
# Connection string for the cluster that stores market notes. Without it the
# blog falls back to the six bundled starter notes and the admin cannot save.
# Atlas: Database → Connect → Drivers. Remember to allow-list your IP.
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"

# Database name inside that cluster. Defaults to "beyondpips" if omitted.
MONGODB_DB="beyondpips"

# ── Admin sign-in ────────────────────────────────────────────────────────────
# The single admin password, compared in constant time on the server. Never
# reaches the browser bundle (no NEXT_PUBLIC_ prefix).
# CHANGE THIS BEFORE THE SITE IS PUBLIC.
ADMIN_PASSWORD="12345678"

# Signs the admin session cookie. Needs 16+ characters and must be secret —
# anyone who has it can mint a valid admin session. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"

# ── Contact form → Google Sheet ───────────────────────────────────────────────
# Apps Script web-app URL that appends Name / Email / PhoneNumber to the sheet.
# Deploy → Manage deployments → Web app URL. Re-deploying the script issues a
# NEW /exec URL, so update this whenever the script changes.
# Server-only (no NEXT_PUBLIC_ prefix), so it never reaches the browser bundle.
GOOGLE_SHEET_WEBHOOK_URL="https://script.google.com/macros/s/AKfycbzUnUj7GmMFl7f8j8idm9KGuMAZ20BIZTj7z34qpXNCmNdtKQHwH2aN7Hdh_RzO50aU/exec"
